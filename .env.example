# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://ransomshield:ransomshield_dev_pass@localhost:5432/ransomshield
POSTGRES_USER=ransomshield
POSTGRES_PASSWORD=ransomshield_dev_pass
POSTGRES_DB=ransomshield
PRISMA_DATABASE_URL="postgresql://ransomshield:ransomshield_dev_pass@localhost:5432/ransomshield?schema=public"

# Security & JWT (Change JWT_SECRET_KEY in production!)
JWT_SECRET_KEY=change-this-to-a-long-random-hex-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial Admin Bootstrap (set these before first startup)
INITIAL_ADMIN_EMAIL=admin@ransomshield.dev
INITIAL_ADMIN_PASSWORD=ChangeMeAdmin!2026
INITIAL_ADMIN_NAME=Security Administrator

# File Upload & Storage
MAX_UPLOAD_SIZE_MB=50
MAX_DATASET_SIZE_MB=100
STORAGE_DIR=./storage

# CORS & Frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
