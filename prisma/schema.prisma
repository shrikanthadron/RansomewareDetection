generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model admin_logs {
  id         String   @id @db.Uuid
  admin_id   String?  @db.Uuid
  action     String   @db.VarChar(128)
  details    String?
  ip_address String?  @db.VarChar(64)
  created_at DateTime @db.Timestamptz(6)
  users      users?   @relation(fields: [admin_id], references: [id], onUpdate: NoAction)

  @@index([action], map: "ix_admin_logs_action")
  @@index([admin_id], map: "ix_admin_logs_admin_id")
  @@index([created_at], map: "ix_admin_logs_created_at")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model alerts {
  id          String      @id @db.Uuid
  user_id     String?     @db.Uuid
  scan_id     String?     @db.Uuid
  alert_type  String      @db.VarChar(64)
  severity    String      @db.VarChar(32)
  title       String      @db.VarChar(200)
  description String
  is_read     Boolean     @default(false)
  created_at  DateTime    @db.Timestamptz(6)
  file_scans  file_scans? @relation(fields: [scan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "ix_alerts_created_at")
  @@index([is_read], map: "ix_alerts_is_read")
  @@index([severity], map: "ix_alerts_severity")
  @@index([user_id], map: "ix_alerts_user_id")
}

model algorithms {
  id                 String               @id @db.Uuid
  algorithm_name     String               @unique @db.VarChar(100)
  model_version      String               @default("1.0.0") @db.VarChar(50)
  description        String?
  is_active          Boolean              @default(true)
  created_at         DateTime             @db.Timestamptz(6)
  model_training     model_training[]
  prediction_results prediction_results[]
}

model datasets {
  id                String           @id @db.Uuid
  uploaded_by       String?          @db.Uuid
  name              String           @db.VarChar(200)
  description       String?
  dataset_type      String           @default("PE_STATIC_CSV") @db.VarChar(50)
  file_path         String           @db.VarChar(512)
  sample_count      Int              @default(0)
  benign_count      Int              @default(0)
  ransomware_count  Int              @default(0)
  validation_status String           @default("VALIDATED") @db.VarChar(32)
  metadata_json     Json?
  created_at        DateTime         @db.Timestamptz(6)
  users             users?           @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction)
  model_training    model_training[]
}

model extracted_features {
  id            String     @id @db.Uuid
  scan_id       String     @db.Uuid
  feature_name  String     @db.VarChar(128)
  feature_value String
  feature_type  String     @db.VarChar(32)
  created_at    DateTime   @db.Timestamptz(6)
  file_scans    file_scans @relation(fields: [scan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([scan_id], map: "ix_extracted_features_scan_id")
  @@index([scan_id, feature_name], map: "ix_extracted_features_scan_name")
}

model file_scans {
  id                                                          String               @id @db.Uuid
  user_id                                                     String               @db.Uuid
  file_name                                                   String               @db.VarChar(255)
  original_file_name                                          String               @db.VarChar(255)
  file_path                                                   String?              @db.VarChar(512)
  file_size                                                   BigInt
  file_type                                                   String               @db.VarChar(64)
  sha256_hash                                                 String               @db.VarChar(64)
  md5_hash                                                    String               @db.VarChar(32)
  upload_timestamp                                            DateTime             @db.Timestamptz(6)
  scan_status                                                 String               @default("PENDING") @db.VarChar(32)
  scan_duration                                               Float?
  is_user_flagged                                             Boolean              @default(false)
  result_id                                                   String?              @db.Uuid
  alerts                                                      alerts[]
  extracted_features                                          extracted_features[]
  users                                                       users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prediction_results_file_scans_result_idToprediction_results prediction_results?  @relation("file_scans_result_idToprediction_results", fields: [result_id], references: [id], onUpdate: NoAction, map: "fk_file_scans_result_id")
  prediction_results_prediction_results_scan_idTofile_scans   prediction_results[] @relation("prediction_results_scan_idTofile_scans")
  quarantine_records                                          quarantine_records[]
  scan_reports                                                scan_reports[]

  @@index([md5_hash], map: "ix_file_scans_md5_hash")
  @@index([sha256_hash], map: "ix_file_scans_sha256_hash")
  @@index([scan_status], map: "ix_file_scans_status")
  @@index([upload_timestamp], map: "ix_file_scans_upload_timestamp")
  @@index([user_id], map: "ix_file_scans_user_id")
  @@index([user_id, upload_timestamp], map: "ix_file_scans_user_timestamp")
}

model model_training {
  id                  String               @id @db.Uuid
  dataset_id          String               @db.Uuid
  algorithm_id        String               @db.Uuid
  training_status     String               @default("PENDING") @db.VarChar(32)
  training_date       DateTime             @db.Timestamptz(6)
  model_version       String               @db.VarChar(64)
  accuracy            Float?
  precision           Float?
  recall              Float?
  f1_score            Float?
  roc_auc             Float?
  confusion_matrix    Json?
  training_parameters Json?
  evaluation_details  Json?
  artifact_path       String?              @db.VarChar(512)
  is_active           Boolean              @default(false)
  created_by          String?              @db.Uuid
  created_at          DateTime             @db.Timestamptz(6)
  algorithms          algorithms           @relation(fields: [algorithm_id], references: [id], onUpdate: NoAction)
  users               users?               @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  datasets            datasets             @relation(fields: [dataset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prediction_results  prediction_results[]

  @@index([is_active, training_status], map: "ix_model_training_active")
  @@index([algorithm_id], map: "ix_model_training_algorithm_id")
  @@index([dataset_id], map: "ix_model_training_dataset_id")
  @@index([is_active], map: "ix_model_training_is_active")
  @@index([training_status], map: "ix_model_training_training_status")
}

model prediction_results {
  id                                                  String          @id @db.Uuid
  scan_id                                             String          @db.Uuid
  algorithm_id                                        String?         @db.Uuid
  model_training_id                                   String?         @db.Uuid
  prediction                                          String          @db.VarChar(32)
  risk_score                                          Float
  risk_level                                          String          @db.VarChar(32)
  confidence                                          Float
  ml_used                                             Boolean         @default(false)
  explanation                                         Json?
  created_at                                          DateTime        @db.Timestamptz(6)
  file_scans_file_scans_result_idToprediction_results file_scans[]    @relation("file_scans_result_idToprediction_results")
  algorithms                                          algorithms?     @relation(fields: [algorithm_id], references: [id], onUpdate: NoAction)
  model_training                                      model_training? @relation(fields: [model_training_id], references: [id], onUpdate: NoAction)
  file_scans_prediction_results_scan_idTofile_scans   file_scans      @relation("prediction_results_scan_idTofile_scans", fields: [scan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "ix_prediction_results_created_at")
  @@index([prediction], map: "ix_prediction_results_prediction")
  @@index([risk_level], map: "ix_prediction_results_risk_level")
  @@index([risk_score], map: "ix_prediction_results_risk_score")
  @@index([scan_id], map: "ix_prediction_results_scan_id")
}

model process_monitoring_logs {
  id               String   @id @db.Uuid
  process_name     String   @db.VarChar(255)
  process_id       Int
  executable_path  String?  @db.VarChar(1024)
  sha256_hash      String?  @db.VarChar(64)
  risk_score       Float    @default(0)
  classification   String   @default("BENIGN") @db.VarChar(32)
  detection_source String   @default("PSUTIL_METADATA") @db.VarChar(64)
  action_taken     String   @default("LOG") @db.VarChar(64)
  metadata_json    Json?
  timestamp        DateTime @db.Timestamptz(6)

  @@index([process_id], map: "ix_process_monitoring_logs_process_id")
  @@index([process_name], map: "ix_process_monitoring_logs_process_name")
  @@index([sha256_hash], map: "ix_process_monitoring_logs_sha256_hash")
  @@index([timestamp], map: "ix_process_monitoring_logs_timestamp")
}

model quarantine_records {
  id                String      @id @db.Uuid
  scan_id           String?     @db.Uuid
  original_path     String      @db.VarChar(1024)
  quarantine_path   String      @db.VarChar(1024)
  sha256_hash       String      @db.VarChar(64)
  quarantine_status String      @default("QUARANTINED") @db.VarChar(32)
  quarantined_at    DateTime    @db.Timestamptz(6)
  restored_at       DateTime?   @db.Timestamptz(6)
  created_by        String?     @db.Uuid
  users             users?      @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  file_scans        file_scans? @relation(fields: [scan_id], references: [id], onUpdate: NoAction)

  @@index([quarantine_status], map: "ix_quarantine_records_quarantine_status")
  @@index([sha256_hash], map: "ix_quarantine_records_sha256_hash")
  @@index([quarantine_status, quarantined_at], map: "ix_quarantine_status_time")
}

model scan_reports {
  id           String      @id @db.Uuid
  user_id      String?     @db.Uuid
  scan_id      String?     @db.Uuid
  report_path  String      @db.VarChar(512)
  report_type  String      @db.VarChar(50)
  generated_at DateTime    @db.Timestamptz(6)
  file_scans   file_scans? @relation(fields: [scan_id], references: [id], onUpdate: NoAction)
  users        users?      @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([scan_id], map: "ix_scan_reports_scan_id")
  @@index([user_id], map: "ix_scan_reports_user_id")
}

model system_settings {
  id            String   @id @db.Uuid
  setting_key   String   @unique(map: "ix_system_settings_setting_key") @db.VarChar(128)
  setting_value String
  updated_at    DateTime @db.Timestamptz(6)
}

model users {
  id                    String               @id @db.Uuid
  full_name             String               @db.VarChar(150)
  email                 String               @unique(map: "ix_users_email") @db.VarChar(255)
  password_hash         String               @db.VarChar(255)
  role                  String               @default("USER") @db.VarChar(20)
  is_active             Boolean              @default(true)
  failed_login_attempts Int                  @default(0)
  locked_until          DateTime?            @db.Timestamptz(6)
  preferences           Json?
  created_at            DateTime             @db.Timestamptz(6)
  updated_at            DateTime             @db.Timestamptz(6)
  last_login            DateTime?            @db.Timestamptz(6)
  admin_logs            admin_logs[]
  alerts                alerts[]
  datasets              datasets[]
  file_scans            file_scans[]
  model_training        model_training[]
  quarantine_records    quarantine_records[]
  scan_reports          scan_reports[]

  @@index([role, is_active], map: "ix_users_role_active")
}
